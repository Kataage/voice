# Copy this file to .env in the repository root. PersonaVoice reads only the
# explicit allowlist shown here and never replaces values inherited from the
# launching process. Keep the real .env private; it is ignored by Git.

# Hugging Face gated model access. Leave blank when the shared cache is already
# materialized or provide HF_TOKEN in the parent process instead.
HF_TOKEN=

# Modal credentials. Prefer `modal token set`; process variables take priority.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=

# Non-secret Modal resource defaults.
PERSONAVOICE_MODAL_APP=personavoice-training
PERSONAVOICE_MODAL_FUNCTION=train
PERSONAVOICE_MODAL_VOLUME=personavoice-training
PERSONAVOICE_MODAL_GPU=A100-40GB
PERSONAVOICE_MODAL_HF_SECRET=personavoice-huggingface
PERSONAVOICE_MODAL_TIMEOUT_SECONDS=86400
PERSONAVOICE_MODAL_RETRIES=2
PERSONAVOICE_MODAL_POLL_SECONDS=10
