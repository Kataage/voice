# Python / uv
.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-*/
.test-*/
.ruff_cache/

# Local runtime and persona artifacts
.runtime/
models/
vendor/
personas/*/persona.yaml
personas/*/raw/*
personas/*/identity/*
personas/*/dataset/*
personas/*/references/*
personas/*/models/*
personas/*/outputs/*
personas/*/cache/*
personas/*/logs/*
personas/*/state.json

# Keep only empty directory markers by default. A real persona configuration can
# contain a person's name, consent notes, and local training choices, so it is
# intentionally private unless the operator force-adds it after review.
!personas/*/raw/.gitkeep
!personas/*/identity/.gitkeep
!personas/*/dataset/.gitkeep
!personas/*/references/.gitkeep
!personas/*/models/.gitkeep
!personas/*/outputs/.gitkeep
!personas/*/cache/.gitkeep
!personas/*/logs/.gitkeep

# Secrets
.env
*.token

